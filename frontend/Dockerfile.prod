# Production image: build the app, then serve the built files with nginx.
# The dev Dockerfile is left untouched so `docker compose up -d` keeps hot reload.

# syntax=docker/dockerfile:1

# --- Build stage -------------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Vite inlines env vars at build time, so they have to be supplied here rather
# than at runtime.
ARG VITE_GEMINI_API_KEY
ARG VITE_GEMINI_MODEL=gemini-2.5-flash-lite
ENV VITE_GEMINI_API_KEY=$VITE_GEMINI_API_KEY
ENV VITE_GEMINI_MODEL=$VITE_GEMINI_MODEL

RUN npm run build

# --- Runtime stage -----------------------------------------------------------
FROM nginx:1.27-alpine AS runtime

# Where the API lives. Overridden at deploy time; the name matches the service in
# docker-compose, and on Render it is that service's URL.
ENV BACKEND_ORIGIN=http://backend:5050
# Only substitute BACKEND_* here, so nginx's own $host / $uri variables survive.
ENV NGINX_ENVSUBST_FILTER=BACKEND_

COPY nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
# 127.0.0.1 rather than localhost: BusyBox wget resolves localhost to ::1.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
